# Copy this file to .env and fill in what you have. Everything is optional:
# with nothing set, the app uses the bundled offline graph and template answers.

# --- Neo4j ---------------------------------------------------------------
# Neo4j Desktop (local DBMS):
#   NEO4J_URI=bolt://localhost:7687
# Neo4j AuraDB Free (from the credentials file you download at creation):
#   NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- LLM (any OpenAI-compatible endpoint) -----------------------------------
# Groq (free tier):   LLM_BASE_URL=https://api.groq.com/openai/v1    LLM_MODEL=llama-3.1-8b-instant
# OpenAI:             LLM_BASE_URL=https://api.openai.com/v1         LLM_MODEL=gpt-4o-mini
# Gemini:             LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   LLM_MODEL=gemini-2.0-flash
# Ollama (local, no key): LLM_BASE_URL=http://localhost:11434/v1    LLM_MODEL=llama3.1
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
